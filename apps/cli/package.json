{
  "name": "@ai-os/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ai-os": "dist/index.js",
    "ai-os-source-sync": "dist/source-sync-report.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js",
    "dev": "pnpm -r build && node --experimental-strip-types src/index.ts doctor",
    "source:sync-actionable": "pnpm -r --sort build && node dist/source-sync-report.js"
  },
  "dependencies": {
    "@ai-os/archive-ingest": "workspace:*",
    "@ai-os/batch-ingest": "workspace:*",
    "@ai-os/config": "workspace:*",
    "@ai-os/database": "workspace:*",
    "@ai-os/import-sources": "workspace:*",
    "@ai-os/memory-core": "workspace:*",
    "@ai-os/project-registry": "workspace:*",
    "@ai-os/provider-import": "workspace:*",
    "@ai-os/session-core": "workspace:*",
    "@ai-os/session-store": "workspace:*"
  }
}
