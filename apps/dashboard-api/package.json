{
  "name": "@ai-os/dashboard-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js",
    "start": "node dist/entry.js",
    "dev": "pnpm -r --sort build && node --experimental-strip-types src/entry.ts"
  },
  "dependencies": {
    "@ai-os/config": "workspace:*",
    "@ai-os/database": "workspace:*",
    "@ai-os/import-sources": "workspace:*",
    "@ai-os/provider-import": "workspace:*",
    "@ai-os/session-store": "workspace:*"
  }
}
