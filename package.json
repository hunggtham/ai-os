{
  "name": "ai-os",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --sort build",
    "check": "pnpm -r --sort build && pnpm -r check",
    "test": "pnpm -r --sort test",
    "bootstrap": "pnpm build && node scripts/bootstrap.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "smoke:clean": "pnpm build && node scripts/smoke-clean-machine.mjs",
    "smoke:backup-restore": "pnpm build && node scripts/smoke-backup-restore.mjs",
    "smoke:e2e": "pnpm build && node scripts/smoke-full-e2e.mjs",
    "provider:sources:status": "pnpm --filter @ai-os/cli exec node dist/index.js provider:sources:status config/import-sources.yaml",
    "dev:cli": "pnpm --filter @ai-os/cli dev",
    "dev:mcp": "pnpm --filter @ai-os/mcp-server dev",
    "dev:api": "pnpm --filter @ai-os/dashboard-api dev"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "typescript": "^5.9.2"
  }
}
