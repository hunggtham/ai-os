{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/memory.schema.json",
  "title": "AI OS Durable Memory Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "scope",
    "category",
    "content",
    "status",
    "createdAt",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["global", "user", "project", "agent"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "category": {
      "enum": ["preference", "goal", "convention", "fact", "relationship"]
    },
    "content": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "status": { "enum": ["candidate", "active", "superseded", "invalid", "deleted"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "supersedes": { "type": ["string", "null"] },
    "tags": {
      "type": "array",
      "items": { "type": "string", "maxLength": 80 },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "sourceId"],
      "properties": {
        "sourceType": { "enum": ["explicit-user", "session", "document", "system", "import"] },
        "sourceId": { "type": "string", "minLength": 1 },
        "excerpt": { "type": ["string", "null"], "maxLength": 1000 },
        "recordedBy": { "type": ["string", "null"], "maxLength": 160 }
      }
    }
  }
}
